# Конфигурация проекта (не-секретные настройки)

# Активный провайдер LLM: zai / openai / anthropic / groq / deepseek / kimi / google / mimo / hf
ACTIVE_PROVIDER=kimi

# --- ZAI (GLM) ---
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-5.2

# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) ---
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Groq ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Kimi (Moonshot) ---
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3

# --- Локальная модель (Ollama) ---
# Единая модель для всех локальных вызовов (local_router, book_search,
# intent_router). Reasoning-модели (gemma4) вызываются с think:false.
OLLAMA_MODEL=gemma4:e2b

# --- Google (Gemini) ---
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-2.5-flash-lite

# --- Mimo ---
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# --- HuggingFace ---
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Память ---
DATA_DIR=./data
STM_SIZE=20
LTM_EXTRACTION_ENABLED=true
# Модель для извлечения фактов: любой провайдер из списка выше
LTM_MODEL_PROVIDER=

# --- Per-provider rate limits (секунд между запросами) ---
# Глобальный дефолт для провайдеров:
LLM_RATE_LIMIT_INTERVAL=1.5
# Per-provider override (RATE_LIMIT_<PROVIDER>=<seconds>):
# Если провайдер не указан — используется LLM_RATE_LIMIT_INTERVAL
RATE_LIMIT_ZAI=20.0
RATE_LIMIT_HF=2.0

# Export server (Коннор)
EXPORT_PORT=8080

# User IDs — заданы в .env