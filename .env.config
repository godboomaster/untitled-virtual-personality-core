# Конфигурация проекта (не-секретные настройки)
# Можно заливать на GitHub

# Активный провайдер LLM: zai / openai / anthropic / groq / deepseek / kimi / google / mimo / hf
ACTIVE_PROVIDER=zai

# --- ZAI (GLM) ---
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-4-plus

# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) ---
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Groq ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Kimi (Moonshot) ---
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# --- Google (Gemini) ---
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-2.5-flash-lite

# --- Google альтернативы (если лимит исчерпан) ---
# gemini-2.5-flash-lite — быстрый, дешевый, меньше лимитов
# gemini-1.5-flash — стабильный, широкие лимиты
# gemini-1.5-flash-8b — самый дешевый, для простых задач

# --- Mimo ---
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# --- HuggingFace ---
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Память ---
DATA_DIR=./data
STM_SIZE=20
LTM_EXTRACTION_ENABLED=true
# Модель для извлечения фактов: любой провайдер из списка выше
LTM_MODEL_PROVIDER=hf

# --- Per-provider rate limits (секунд между запросами) ---
# Глобальный дефолт для провайдеров без override:
LLM_RATE_LIMIT_INTERVAL=1.5
# Per-provider override (RATE_LIMIT_<PROVIDER>=<seconds>):
# Если провайдер не указан — используется LLM_RATE_LIMIT_INTERVAL
RATE_LIMIT_ZAI=20.0
RATE_LIMIT_HF=2.0

# Export server (Коннор)
EXPORT_PORT=8080

# User IDs — заданы в .env
# OWNER_USER_ID
# ARRODES_SPECIAL_USER_ID
RATE_LIMIT_USER_734961317=0
RATE_LIMIT_USER_822600648=0
RATE_LIMIT_USER_1562061012=30
RATE_LIMIT_USER_1246371068=30
RATE_LIMIT_USER_8622725425=30
