# Несекретные настройки по умолчанию (в git). Личные значения — в .env: он
# важнее этого файла. Провайдер, модели и ключи здесь не задаются — их выбирает
# пользователь: в вебе («Настройки», досье персоны) или в .env

# --- Память ---
# Папка данных — VPC_DATA_DIR в .env (по умолчанию ./data)
STM_SIZE=20
LTM_EXTRACTION_ENABLED=true

# Export server
EXPORT_PORT=8080
