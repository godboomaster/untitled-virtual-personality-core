# Личные настройки: скопируйте в .env и заполните нужное. Пустое значение —
# не задано. Несекретные значения по умолчанию — в .env.config (в git), .env
# важнее. Почти всё это меняется и из веба: «Настройки», досье персоны.
# Пустое значение пишите без комментария в той же строке — пояснения строкой выше.

# ─── Провайдеры LLM ──────────────────────────────────────
# Нужен хотя бы один источник ответов: ключ провайдера и его модель, веб-чат
# (WEBCHAT_SITES ниже) или Ollama (OLLAMA_MODEL ниже). Моделей по умолчанию нет:
# провайдер без модели не используется.
# Запасные ключи одного провайдера — <ПРОВАЙДЕР>_API_KEY_1, _API_KEY_2 и т.д.
# Свой адрес API — <ПРОВАЙДЕР>_BASE_URL (по умолчанию — официальный).
# Vision — <ПРОВАЙДЕР>_VISION=auto|true|false (auto — проверка тестовой картинкой).
# основной провайдер: zai / openai / anthropic / groq / deepseek / kimi / google / mimo / hf / local (пусто — первый с ключом и моделью)
ACTIVE_PROVIDER=

ZAI_API_KEY=
ZAI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Kimi принимает только temperature 1.0 и top_p 0.95 (KIMI_TEMPERATURE, KIMI_TOP_P)
KIMI_API_KEY=
KIMI_MODEL=

GOOGLE_API_KEY=
GOOGLE_MODEL=

MIMO_API_KEY=
MIMO_MODEL=

HF_API_KEY=
HF_MODEL=

# ─── Веб-чаты LLM (браузер бота, без ключей) ────────────
# сайты через запятую, порядок = порядок перебора: deepseek, qwen, claude, zai, chatgpt, kimi, google, duckai
WEBCHAT_SITES=

# ─── Локальная модель (Ollama) ───────────────────────────
OLLAMA_URL=http://localhost:11434  # адрес сервера Ollama
# модель для локальных вызовов, например gemma4:e2b (сначала: ollama pull <модель>)
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192                 # размер контекстного окна (токены)
OLLAMA_KEEP_ALIVE=2m                # сколько держать модель в памяти после вызова
# движок служебных задач без явной записи у персоны: ollama | webchat (по умолчанию ollama)
# LOCAL_LLM_BACKEND=ollama
# Ollama для docker compose (OLLAMA_URL там не используется: localhost в контейнере — сам контейнер)
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# ─── Telegram ───────────────────────────────────────────
# Токен бота персоны: <ПЕРСОНА>_BOT_TOKEN, где <ПЕРСОНА> — id персоны (имя её
# YAML-файла) заглавными. Меню python -m app.main и режим all запускают только
# персон с токеном.
CONNOR_BOT_TOKEN=
# Telegram ID владельца: команды владельца и режим управления
OWNER_USER_ID=
# Лимит сообщений для персон с features.rate_limit: сообщений за окно RATE_WINDOW (секунд)
RATE_LIMIT_DEFAULT=6
RATE_WINDOW=3600
# Свой лимит пользователя: RATE_LIMIT_USER_<ID>=N (0 — без лимита)

# Аддон Арродеса: токен бота и Telegram ID особого собеседника
ARRODES_BOT_TOKEN=
ARRODES_SPECIAL_USER_ID=

# ─── Запуск и память ────────────────────────────────────
# цель запуска: id персоны, all или api (пусто — меню)
BOT_TARGET=
# Папка данных — память, персоны пользователя (data/personas). По умолчанию ./data;
# VPC_DATA_DIR — служебные файлы и персоны, DATA_DIR — базы памяти, обычно одна папка
# VPC_DATA_DIR=./data
# провайдер для извлечения фактов (пусто — цепочка персоны)
LTM_MODEL_PROVIDER=
CHAT_RETENTION_DAYS=180             # чат без активности дольше N дней — его записи (known_chats, состояние, отношения) удаляются при загрузке
RETENTION_TICK_HOURS=6              # как часто прореживать на живом процессе (при загрузке — всегда)

# ─── API сервер ─────────────────────────────────────────
API_PORT=8000           # порт запуска API сервера
API_HOST=127.0.0.1      # адрес привязки (0.0.0.0 — доступен из сети)
# токен для защиты API-запросов (пусто — без токена); веб спросит его на экране запуска
API_TOKEN=
# Страницы, которым можно обращаться к API, через запятую. Пусто — только свой фронт на этой
# машине (localhost / 127.0.0.1 на любом порту); любой другой сайт получает 403. Список заменяет
# это правило целиком (localhost добавьте сам, если нужен); * — любой сайт (небезопасно)
API_CORS_ORIGINS=
# Имена хоста (заголовок Host) сверх localhost/127.0.0.1, через запятую — защита от DNS rebinding.
# Пусто: при API_HOST=127.0.0.1 — только локальные имена; при привязке наружу Host не проверяется
API_ALLOWED_HOSTS=
API_WARMUP_HOURS=48     # при старте загружать персоны, с которыми общались за N часов (0 — выкл)
# WEB_PORT=5173          # порт веб-интерфейса в docker compose

# ─── Export server (экспорт памяти по HTTP) ──────────────
EXPORT_PORT=8080
EXPORT_HOST=127.0.0.1   # 0.0.0.0 — открыть доступ из сети (небезопасно без токена)
# токен экспорта (?token= или Authorization: Bearer); пусто — создаётся при первом запуске
# в файле export_token в папке данных
EXPORT_TOKEN=

# ─── Часовой пояс ───────────────────────────────────────
# Часовой пояс пользователя (имя зоны IANA, например Europe/Moscow; пусто — системный пояс,
# в Docker это UTC — там задайте явно)
TIMEZONE=
