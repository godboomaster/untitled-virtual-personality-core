# ─── API провайдеры ───
# Заполни ключи для нужных провайдеров.
# Провайдеры без ключей автоматически пропускаются.
# ACTIVE_PROVIDER — основной, остальные = fallback по порядку.

ACTIVE_PROVIDER=zai

# ZAI (GLM)
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-5-turbo

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Groq
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Google (Gemini)
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-2.0-flash

# Mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# HuggingFace
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ─── Telegram боты ───
CONNOR_BOT_TOKEN=
ARRODES_BOT_TOKEN=

# ─── Настройки ───
DATA_DIR=./data
STM_SIZE=50
LTM_EXTRACTION_ENABLED=true
LTM_MODEL_PROVIDER=hf

# ─── Rate limiter (Арродес) ───
RATE_LIMIT_DEFAULT=6
RATE_WINDOW=3600

# ─── Export server (Коннор) ───
EXPORT_PORT=8080
