# API ключи и параметры провайдеров LLM
# Порядок ключей задаёт fallback-очередь провайдеров, когда ACTIVE_PROVIDER не указан
GROQ_API_KEY=gsk_...
GROQ_API_KEY_1=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION=auto

HF_API_KEY=...
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION=auto

ZAI_API_KEY=...
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-5-turbo
ZAI_VISION=auto

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VISION=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION=auto

# Deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION=auto

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_VISION=auto

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_VISION=auto
KIMI_TEMPERATURE=1.0                # Kimi требует только 1.0
KIMI_TOP_P=0.95                     # Kimi требует только 0.95

# Mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_VISION=auto

# Telegram Bot Tokens
# Общее правило для любой персоны: <ПЕРСОНА>_BOT_TOKEN, где <ПЕРСОНА> — имя
# файла app/personas/<персона>.yaml в верхнем регистре. Меню python -m app.main
# и режим all показывают и запускают только персон с заданным здесь токеном.
CONNOR_BOT_TOKEN=...
ARRODES_BOT_TOKEN=...

# Arrodes special user
ARRODES_SPECIAL_USER_ID=12345678

# Owner user ID
OWNER_USER_ID=12345678

# Per-user rate limits
RATE_LIMIT_USER_12345678=0  # нет лимита
RATE_LIMIT_USER_87654321=30 # лимит в 30 сообщений

# Глобальные лимиты и настройки памяти
RATE_LIMIT_DEFAULT=6                # лимит сообщений пользователя за окно RATE_WINDOW (дефолт 6)
RATE_WINDOW=3600                    # окно времени лимитирования в секундах
ACTIVE_PROVIDER=                    # активный провайдер (пусто — первый из доступных)
BOT_TARGET=                         # цель запуска: имя персоны (см. <ПЕРСОНА>_BOT_TOKEN выше), all или api (пусто — интерактивное меню)
DATA_DIR=./data                     # директория хранения данных памяти
VPC_DATA_DIR=                       # папка данных ядра (по умолчанию ./data, относительно текущей папки); задать отдельно у аддона (например, Арродеса), чтобы не смешивать данные с ядром или указать общую с ним папку
STM_SIZE=500                        # размер краткосрочной памяти (сообщений)
LTM_EXTRACTION_ENABLED=true         # включить долгосрочную память (экстракцию фактов)
LTM_MODEL_PROVIDER=                 # провайдер для долгосрочной памяти (пусто — основной роутер)
CHAT_RETENTION_DAYS=180             # чат без активности дольше N дней — его записи (known_chats, состояние, отношения) удаляются при загрузке
RETENTION_TICK_HOURS=6              # как часто прореживать на живом процессе (при загрузке — всегда)

# API сервер
API_PORT=8000           # порт запуска API сервера
API_HOST=127.0.0.1      # адрес привязки (0.0.0.0 — доступен из сети)
API_TOKEN=              # токен для защиты API-запросов
API_CORS_ORIGINS=       # CORS источники через запятую (например: http://localhost:3000,https://example.com)
API_WARMUP_HOURS=48     # при старте загружать персоны, с которыми общались за N часов (0 — выкл)

# Export server (экспорт памяти по HTTP)
EXPORT_PORT=8080
EXPORT_HOST=127.0.0.1   # 0.0.0.0 — открыть доступ из сети (небезопасно без токена)
EXPORT_TOKEN=           # если задан — обязателен ?token= или Authorization: Bearer

# Часовой пояс пользователя (имя зоны IANA, например Europe/Moscow; пусто — системный пояс)
TIMEZONE=
# TZ=Europe/Moscow                     # POSIX-фолбэк если TIMEZONE не задан

# Vision (распознавание изображений): auto | true | false
# auto — бот сам проверит модель тестовой картинкой при первом изображении
# KIMI_VISION=auto

# Локальная модель (Ollama)
OLLAMA_URL=http://localhost:11434  # адрес сервера Ollama
OLLAMA_MODEL=gemma4:e2b             # модель для локальных вызовов
OLLAMA_NUM_CTX=8192                 # размер контекстного окна (токены, дефолт 8192)
OLLAMA_KEEP_ALIVE=2m                # сколько держать модель в памяти после вызова (дефолт 2m)
LOCAL_LLM_BACKEND=ollama            # движок локальных задач без явной записи: ollama | webchat

# Веб-чаты LLM-сайтов (браузерный канал)
WEBCHAT_SITE=                       # legacy: один сайт веб-чата (добавляется к WEBCHAT_SITES, если его там нет)
WEBCHAT_SITES=                      # сайты веб-чата через запятую, порядок = порядок перебора
