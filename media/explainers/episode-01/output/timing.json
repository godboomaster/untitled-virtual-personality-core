{
  "duration": 71.66666666666667,
  "scenes": [
    {
      "start": 0,
      "end": 6.74125,
      "id": "hello",
      "lines": [
        {
          "start": 0.42,
          "end": 2.3093333333333335,
          "text": "Буу! Привет! Я Бу."
        },
        {
          "start": 2.529333333333333,
          "end": 6.141249999999999,
          "text": "Пугать не буду. Покажу, что такое Virtual Persona Core."
        }
      ]
    },
    {
      "start": 6.74125,
      "end": 18.138333333333332,
      "id": "character",
      "lines": [
        {
          "start": 7.16125,
          "end": 12.64325,
          "text": "Здесь ты создаёшь цифрового персонажа:\nвыбираешь характер, манеру общения и умения."
        },
        {
          "start": 12.86325,
          "end": 17.538333333333334,
          "text": "Хочешь — серьёзного наставника.\nХочешь — весёлого напарника."
        }
      ]
    },
    {
      "start": 18.138333333333332,
      "end": 26.02875,
      "id": "memory",
      "lines": [
        {
          "start": 18.558333333333334,
          "end": 23.006125,
          "text": "Пишешь ему обычными словами.\nА он отвечает и запоминает важное о тебе."
        },
        {
          "start": 23.226125,
          "end": 25.42875,
          "text": "Например, что ты учишь английский."
        }
      ]
    },
    {
      "start": 26.02875,
      "end": 34.143208333333334,
      "id": "help",
      "lines": [
        {
          "start": 26.44875,
          "end": 31.15875,
          "text": "Можно попросить напомнить о деле,\nсохранить заметку или помочь с учёбой."
        },
        {
          "start": 31.37875,
          "end": 33.54320833333333,
          "text": "Всё в разговоре. Без заклинаний!"
        }
      ]
    },
    {
      "start": 34.143208333333334,
      "end": 44.46779166666667,
      "id": "life",
      "lines": [
        {
          "start": 34.563208333333336,
          "end": 37.811125000000004,
          "text": "У персонажа есть настроение\nи своя маленькая история."
        },
        {
          "start": 38.031125,
          "end": 43.86779166666667,
          "text": "Если включить инициативу, он может написать первым.\nДаже спросить, как прошёл день."
        }
      ]
    },
    {
      "start": 44.46779166666667,
      "end": 52.01537500000001,
      "id": "everywhere",
      "lines": [
        {
          "start": 44.88779166666667,
          "end": 48.83204166666667,
          "text": "Общаться можно в браузере, в Telegram\nи в приложении на Android."
        },
        {
          "start": 49.052041666666675,
          "end": 51.41537500000001,
          "text": "Текстом или голосом — как удобнее."
        }
      ]
    },
    {
      "start": 52.01537500000001,
      "end": 61.05475000000001,
      "id": "start",
      "lines": [
        {
          "start": 52.435375000000015,
          "end": 56.946208333333345,
          "text": "Для начала выбираешь персонажа\nи подключаешь ему модель, которая отвечает."
        },
        {
          "start": 57.166208333333344,
          "end": 60.45475000000001,
          "text": "Через ключ, веб-чат или локально, через Ollama."
        }
      ]
    },
    {
      "start": 61.05475000000001,
      "end": 71.65100000000001,
      "id": "bye",
      "lines": [
        {
          "start": 61.474750000000014,
          "end": 65.69775000000001,
          "text": "Вот и всё: персонаж с характером,\nпамятью и полезными умениями."
        },
        {
          "start": 65.91775000000001,
          "end": 70.38100000000001,
          "text": "В следующем ролике вместе запустим проект\nи скажем первое «привет». Бу!"
        }
      ]
    }
  ]
}