<?xml version="1.0" encoding="utf-8"?>
<!-- «Жидкое стекло» пустого виджета «Живой портрет» (персона поверх
     приложений): полупрозрачный серый, блик сверху и тонкая светлая кромка.
     Размыть обои под виджетом Android не даёт — стекло только кажется -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Толща стекла: светлее сверху, темнее снизу -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:endColor="#66505050"
                android:startColor="#7A9A9A9A" />
        </shape>
    </item>
    <!-- Блик: верхняя половина, к середине сходит на нет -->
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#29FFFFFF" />
        </shape>
    </item>
    <!-- Кромка -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
