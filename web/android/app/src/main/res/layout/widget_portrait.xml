<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Живой портрет» (PortraitWidget): голова персоны прямо на обоях,
     без рамки. Кадры кладёт код в portrait_flipper — лаунчер листает их сам
     раз в flipInterval (= кадр сценки) и только пока виджет на экране.
     Облачко с репликой персоны (тап — чат) лежит поверх, у верхнего края, —
     голова под ним не сжимается; место над головой освобождает код (отступ
     сцены portrait_stage). Облачко с сообщением пользователя — слева вверху,
     пока персона его читает и думает над ответом (portrait_user_box). Над головой — сердечко, когда гладят
     (portrait_fx), и «z», когда спит (portrait_z); в углу — карандаш
     «Написать» (portrait_write).
     Портрета нет — подсказка в рамке (на обоях текст иначе не прочесть) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/portrait_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/portrait_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ViewFlipper
            android:id="@+id/portrait_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="150"
            android:visibility="gone" />

        <ViewFlipper
            android:id="@+id/portrait_fx"
            android:layout_width="40dp"
            android:layout_height="64dp"
            android:layout_gravity="top|center_horizontal"
            android:autoStart="true"
            android:flipInterval="150"
            android:visibility="gone" />

        <ViewFlipper
            android:id="@+id/portrait_z"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:autoStart="true"
            android:flipInterval="1200"
            android:visibility="gone" />

        <TextView
            android:id="@+id/portrait_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bg"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />

        <!-- Карандаш — окно «Написать» (PortraitInputActivity); виден, когда есть портрет -->
        <ImageView
            android:id="@+id/portrait_write"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:background="@drawable/widget_write_bg"
            android:padding="7dp"
            android:src="@drawable/widget_write"
            android:visibility="gone" />

        <!-- «Поверх приложений» — персона выходит из виджета на экран
             (AvatarOverlayService); виден, когда есть портрет -->
        <ImageView
            android:id="@+id/portrait_out"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="2dp"
            android:background="@drawable/widget_write_bg"
            android:padding="7dp"
            android:src="@drawable/widget_out"
            android:visibility="gone" />

        <!-- «Сменить персону» — выбор персоны виджета (PersonaWidgetConfigure) -->
        <ImageView
            android:id="@+id/portrait_switch"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_margin="2dp"
            android:background="@drawable/widget_write_bg"
            android:padding="7dp"
            android:src="@drawable/widget_switch"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Сообщение пользователя (лента ядра heard или окно «Написать»): персона
         поворачивается к нему, читает, потом думает; висит до ответа. Слева
         вверху: облачка реплик персоны над головой в это время нет, в высоком
         виджете тут пустое место над головой, в квадратном — волосы. Внизу
         слева облачко закрывало лицо: голова, повёрнутая вниз-влево, смещает
         лицо в кадре как раз туда (проверено на эмуляторе); справа внизу —
         карандаш. Взгляд — вверх и влево (PortraitWidgetFrames.read): left, а
         не start — колонки атласа привязаны к сторонам экрана, а не к
         направлению письма. Ширину (доля виджета) ставит код; хвостик — вниз,
         к голове -->
    <LinearLayout
        android:id="@+id/portrait_user_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:ignore="RtlHardcoded">

        <TextView
            android:id="@+id/portrait_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_user_bg"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp"
            android:textColor="@color/widget_user_text"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/portrait_user_tail"
            android:layout_width="10dp"
            android:layout_height="6dp"
            android:layout_gravity="right"
            android:layout_marginTop="-1dp"
            android:layout_marginRight="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_user_tail" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/portrait_bubble_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/portrait_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bubble_bg"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/portrait_bubble_tail"
            android:layout_width="10dp"
            android:layout_height="6dp"
            android:layout_marginTop="-1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_bubble_tail" />
    </LinearLayout>
</FrameLayout>
