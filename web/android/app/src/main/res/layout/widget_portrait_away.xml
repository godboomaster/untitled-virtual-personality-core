<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Живой портрет», пока персона поверх приложений (PortraitWidget,
     AvatarOverlayService.owns): виджет прозрачный, по центру места головы —
     стеклянная карточка (widget_glass) с «Вернуть» посередине. Тап по
     карточке — голова едет обратно; середина карточки — середина головы
     (отступ над головой код ставит корню, как у макета сна) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/portrait_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/portrait_away"
        android:layout_width="112dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_glass"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/portrait_w_back"
        android:textColor="#F2FFFFFF"
        android:textSize="14sp" />
</FrameLayout>
