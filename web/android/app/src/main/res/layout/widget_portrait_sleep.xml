<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Живой портрет», персона спит (PortraitWidget): один неподвижный
     кадр и «z» у макушки. Отдельный макет, а не тот же с одним кадром:
     лаунчер создаёт виды заново, перелистыватель кадров бодрствующего
     портрета отцепляется и перестаёт будить лаунчер раз в 150 мс -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/portrait_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/portrait_still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ViewFlipper
        android:id="@+id/portrait_z"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:autoStart="true"
        android:flipInterval="1200" />

    <!-- Карандаш — окно «Написать» (PortraitInputActivity); виден, когда есть портрет -->
    <ImageView
        android:id="@+id/portrait_write"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="2dp"
        android:background="@drawable/widget_write_bg"
        android:padding="7dp"
        android:src="@drawable/widget_write"
        android:visibility="gone" />

    <!-- «Поверх приложений» — персона выходит из виджета на экран -->
    <ImageView
        android:id="@+id/portrait_out"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="2dp"
        android:background="@drawable/widget_write_bg"
        android:padding="7dp"
        android:src="@drawable/widget_out"
        android:visibility="gone" />

    <!-- «Сменить персону» — выбор персоны виджета (PersonaWidgetConfigure) -->
    <ImageView
        android:id="@+id/portrait_switch"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_margin="2dp"
        android:background="@drawable/widget_write_bg"
        android:padding="7dp"
        android:src="@drawable/widget_switch"
        android:visibility="gone" />
</FrameLayout>
