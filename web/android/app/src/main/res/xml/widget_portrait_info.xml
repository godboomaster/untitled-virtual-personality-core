<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Живой портрет» (PortraitWidget): голова персоны 2×2, растягивается.
     Персону выбирают при установке (PersonaWidgetConfigure), на Android 12+ —
     и потом, долгим нажатием. updatePeriodMillis=0: по расписанию не будит
     телефон — портрет меняют редко, его освежает приложение -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.vpcore.app.PersonaWidgetConfigure"
    android:description="@string/widget_portrait_desc"
    android:initialLayout="@layout/widget_portrait"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="70dp"
    android:minResizeHeight="70dp"
    android:previewLayout="@layout/widget_portrait_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
